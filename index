<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>HP AUDIENCE · Меню</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg: #FFFFFF;
      --tg-blue: #2481CC;
      --tg-blue-hover: #1B6FB4;
      --border: #E5E0D8;
      --accent: #6E5843;
      --text: #1B1816;
      --muted: #6E655F;
      --danger: #C93B3B;
    }
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body {
      margin: 0;
      padding: 18px 16px;
      background: var(--bg);
      color: var(--text);
    }
    .hub-buttons {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 8px;
    }
    .hub-btn {
      width: 100%;
      min-height: 64px;
      padding: 16px 20px;
      border: none;
      border-radius: 12px;
      background: var(--tg-blue);
      color: #FFFFFF;
      font-size: 18px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background 0.15s ease;
    }
    .hub-btn:active { background: var(--tg-blue-hover); transform: scale(0.99); }
    .hub-btn.secondary-style { background: #3D4333; }
    .screen { display: none; }
    .screen.active { display: block; }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      color: var(--tg-blue);
      font-size: 14px;
      font-weight: 600;
      padding: 0 0 12px;
      cursor: pointer;
    }
    .card {
      background: #FAF8F5;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 12px;
    }
    h2 { font-size: 17px; margin: 0 0 4px; }
    .sub { font-size: 13px; color: var(--muted); margin-bottom: 12px; }
    label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 6px; }
    input[type="date"], textarea {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid #CFC6B8;
      border-radius: 10px;
      color: var(--text);
      padding: 11px 12px;
      font-size: 15px;
      outline: none;
    }
    input[type="date"]:focus, textarea:focus { border-color: var(--tg-blue); }
    .upload-box {
      border: 1.5px dashed var(--accent);
      border-radius: 10px;
      padding: 16px;
      text-align: center;
      cursor: pointer;
      background: #FFFFFF;
    }
    .upload-box input { display: none; }
    .preview {
      margin-top: 10px;
      max-width: 100%;
      max-height: 220px;
      border-radius: 8px;
      display: none;
      object-fit: contain;
    }
    .submit-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: var(--tg-blue);
      color: #FFFFFF;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
    }
    .submit-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .status { margin-top: 12px; font-size: 13px; text-align: center; }
    .status.err { color: var(--danger); }
    .status.ok { color: #266D36; font-weight: 600; }
  </style>
</head>
<body>

  <div id="screenHub" class="screen active">
    <div class="hub-buttons">
      <button id="btnExpense" class="hub-btn secondary-style" style="display: none;" onclick="openExpenseApp()">
        💸 Внести расход
      </button>
      <button id="btnShiftClose" class="hub-btn" onclick="showScreen('screenShift')">
        📊 Отчёт о закрытии смены
      </button>
    </div>
    <div id="hubStatus" class="status"></div>
  </div>

  <div id="screenShift" class="screen">
    <button class="back-link" onclick="showScreen('screenHub')">← Назад в меню</button>
    <div class="card">
      <h2>HP AUDIENCE · Итоги смены</h2>
      <div class="sub">Данные по выручке, кассам, чекам, гостям и кальянам подтянутся из iiko</div>

      <label for="shiftDate">Дата смены</label>
      <input type="date" id="shiftDate" />
    </div>

    <div class="card">
      <label>Фото X-отчёта (обязательно)</label>
      <label class="upload-box" for="photoInput">
        <div id="uploadLabel">📷 Нажмите, чтобы прикрепить фото X-отчёта</div>
        <input type="file" id="photoInput" accept="image/*" />
        <img id="previewImg" class="preview" alt="Предпросмотр X-отчёта" />
      </label>
    </div>

    <div class="card">
      <label for="comment">Комментарий по смене (необязательно)</label>
      <textarea id="comment" rows="2" placeholder="Например: смена закрыта без замечаний"></textarea>
    </div>

    <button class="submit-btn" id="submitBtn" onclick="submitShift()">Отправить итоги смены</button>
    <div class="status" id="statusMsg"></div>
  </div>

  <script>
    const GAS_WEBAPP_URL = "https://script.google.com/macros/s/AKfycbwU8aTPrn7BHwpXmXz4NeBc2uBd51c1b2IQ7a45h608R7YJW6upflb3jrDEZ2xA0ihXfA/exec";
    const EXPENSE_APP_URL = "https://natalia93-coder.github.io/HP_AUDIENCE_expenses_app/";

    const tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
    if (tg) {
      tg.ready();
      tg.expand();
    }

    function showScreen(screenId) {
      document.querySelectorAll(".screen").forEach(el => el.classList.remove("active"));
      document.getElementById(screenId).classList.add("active");
    }

    function openExpenseApp() {
      window.location.href = EXPENSE_APP_URL;
    }

    (function initDefaultDate() {
      const now = new Date();
      if (now.getHours() < 6) {
        now.setDate(now.getDate() - 1);
      }
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, "0");
      const dd = String(now.getDate()).padStart(2, "0");
      document.getElementById("shiftDate").value = `${yyyy}-${mm}-${dd}`;
    })();

    (function checkExpenseButtonAccess() {
      const statusEl = document.getElementById("hubStatus");
      const user = tg && tg.initDataUnsafe ? tg.initDataUnsafe.user : null;

      if (!user || !user.id) {
        if (statusEl) statusEl.textContent = "Telegram не передал user.id в initDataUnsafe";
        return;
      }

      const cbName = "onExpenseAccess_" + Date.now();
      const scriptEl = document.createElement("script");

      window[cbName] = function (json) {
        try {
          if (json && json.ok && json.canEnterExpense) {
            document.getElementById("btnExpense").style.display = "flex";
            if (statusEl) statusEl.textContent = "";
          } else if (statusEl) {
            statusEl.textContent = `ID ${user.id}: доступ не подтверждён`;
          }
        } finally {
          delete window[cbName];
          if (scriptEl.parentNode) scriptEl.parentNode.removeChild(scriptEl);
        }
      };

      scriptEl.src = `${GAS_WEBAPP_URL}?action=check_access&userId=${encodeURIComponent(user.id)}&callback=${cbName}`;
      scriptEl.onerror = function () {
        delete window[cbName];
        if (statusEl) statusEl.textContent = "Не удалось загрузить проверку доступа";
      };
      document.body.appendChild(scriptEl);
    })();

    let selectedPhotoBase64 = "";
    let selectedPhotoMime = "image/jpeg";
    let selectedPhotoName = "x-report.jpg";

    document.getElementById("photoInput").addEventListener("change", function (e) {
      const file = e.target.files[0];
      if (!file) return;
      selectedPhotoName = file.name || "x-report.jpg";
      selectedPhotoMime = file.type || "image/jpeg";

      const reader = new FileReader();
      reader.onload = function (ev) {
        const img = new Image();
        img.onload = function () {
          const maxDim = 1600;
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) { h = Math.round(h * maxDim / w); w = maxDim; }
            else { w = Math.round(w * maxDim / h); h = maxDim; }
          }
          const canvas = document.createElement("canvas");
          canvas.width = w;
          canvas.height = h;
          canvas.getContext("2d").drawImage(img, 0, 0, w, h);
          const dataUrl = canvas.toDataURL("image/jpeg", 0.85);
          selectedPhotoBase64 = dataUrl.split(",")[1];
          selectedPhotoMime = "image/jpeg";

          const preview = document.getElementById("previewImg");
          preview.src = dataUrl;
          preview.style.display = "inline-block";
          document.getElementById("uploadLabel").textContent = "✅ Фото прикреплено (нажмите для замены)";
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });

    async function submitShift() {
      const btn = document.getElementById("submitBtn");
      const status = document.getElementById("statusMsg");
      const shiftDate = document.getElementById("shiftDate").value;
      const comment = document.getElementById("comment").value;

      if (!shiftDate) {
        status.className = "status err";
        status.textContent = "Выберите дату смены.";
        return;
      }
      if (!selectedPhotoBase64) {
        status.className = "status err";
        status.textContent = "Прикрепите фото X-отчёта.";
        return;
      }

      btn.disabled = true;
      status.className = "status";
      status.textContent = "⏳ Подтягиваю итоги смены из iiko и отправляю в чат...";

      try {
        const payload = {
          action: "close_shift",
          shiftDate: shiftDate,
          comment: comment,
          photoBase64: selectedPhotoBase64,
          photoMimeType: selectedPhotoMime,
          photoName: selectedPhotoName,
          user: tg && tg.initDataUnsafe ? tg.initDataUnsafe.user : null
        };

        const res = await fetch(GAS_WEBAPP_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        const json = await res.json();
        if (!json.ok) {
          throw new Error(json.error || "Ошибка сервера");
        }

        status.className = "status ok";
        status.textContent = "✅ Отчёт о закрытии смены и фото X-отчёта отправлены!";
        if (tg) {
          setTimeout(() => tg.close(), 1500);
        }
      } catch (err) {
        status.className = "status err";
        status.textContent = "Ошибка: " + err.message;
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>
